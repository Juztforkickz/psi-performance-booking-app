<section class="psi-v3" id="booking-panel" aria-labelledby="psi-v3-title">
  <div class="psi-v3__intro">
    <div>
      <p class="psi-v3__eyebrow">Book your car</p>
      <h2 id="psi-v3-title">Let’s get you sorted.</h2>
    </div>
    <p>Send an enquiry first. PSI will review the work and contact you to confirm the next step.</p>
  </div>

  <div class="psi-v3__layout">
    <div class="psi-v3__workspace">
      {% form 'contact', id: 'PsiBookingFormV3', class: 'psi-v3__form' %}
        {% if form.posted_successfully? %}
          <div class="psi-v3__success" role="status">
            <strong>Enquiry received.</strong>
            <span>Thank you. PSI will review the details and contact you.</span>
          </div>
        {% endif %}
        {{ form.errors | default_errors }}

        <input type="hidden" name="contact[Enquiry type]" value="Service" data-psi-enquiry-type>

        <div class="psi-v3__choice" role="group" aria-label="Enquiry type">
          <p>What are you booking in for?</p>
          <div class="psi-v3__choice-grid">
            <button class="psi-v3__choice-card is-active" type="button" data-psi-kind="service" aria-pressed="true">
              <span>01</span><strong>Service</strong><small>Servicing, inspection, repairs and a clear report.</small>
            </button>
            <button class="psi-v3__choice-card" type="button" data-psi-kind="dyno" aria-pressed="false">
              <span>02</span><strong>Dyno Tuning</strong><small>Tell PSI how the vehicle is set up and what you want from the tune.</small>
            </button>
            <button class="psi-v3__choice-card" type="button" data-psi-kind="plan" aria-pressed="false">
              <span>03</span><strong>Plan Builder</strong><small>Shape a complete project brief across measured stages with PSI.</small>
            </button>
          </div>
        </div>

        <div class="psi-v3__panel" data-psi-panel="service">
          <div class="psi-v3__section-heading"><span>01</span><div><h3>Service enquiry</h3><p>Tell PSI what the vehicle needs or what you would like checked.</p></div></div>
          <label class="psi-v3__field psi-v3__field--wide"><span>What exactly are you after?</span><textarea name="contact[Service request]" rows="6" maxlength="2000" placeholder="Describe the service, symptoms, repairs or concerns." required></textarea></label>
        </div>

        <div class="psi-v3__panel" data-psi-panel="dyno" hidden>
          <div class="psi-v3__section-heading"><span>01</span><div><h3>Dyno Tuning enquiry</h3><p>Choose the closest answers. PSI will confirm suitability and the next step.</p></div></div>
          <label class="psi-v3__field psi-v3__field--wide"><span>Tuning goal</span><textarea name="contact[Tuning goal]" rows="5" maxlength="2000" placeholder="Power, drivability, fuel, faults or the result you want."></textarea></label>
          <fieldset class="psi-v3__confidence">
            <legend>How well do you know the setup?</legend>
            <label><input type="radio" name="contact[Setup confidence]" value="I know my setup" data-psi-confidence="known"> <span><strong>I know my setup</strong>Complete the detailed specification.</span></label>
            <label><input type="radio" name="contact[Setup confidence]" value="PSI inspection requested" data-psi-confidence="inspection"> <span><strong>I’m not sure. Can PSI inspect it?</strong>PSI can help identify the setup before confirming the tuning plan.</span></label>
          </fieldset>

          <div class="psi-v3__spec" data-psi-spec hidden>
            <article class="psi-v3__spec-card">
              <h4><span>01</span>Engine</h4>
              <label class="psi-v3__field"><span>Engine setup</span><select name="contact[Engine setup]"><option value="">Choose stock or modified</option><option>Stock</option><option>Modified</option></select></label>
              <label class="psi-v3__field"><span>Engine modifications</span><textarea name="contact[Engine modifications]" rows="3" placeholder="Engine, induction, boost and internal modifications."></textarea></label>
            </article>
            <article class="psi-v3__spec-card">
              <h4><span>02</span>Transmission</h4>
              <div class="psi-v3__grid">
                <label class="psi-v3__field"><span>Type</span><select name="contact[Transmission type]"><option value="">Choose type</option><option>Automatic</option><option>Manual</option></select></label>
                <label class="psi-v3__field"><span>Setup</span><select name="contact[Transmission setup]"><option value="">Choose setup</option><option>Stock / none</option><option>Upgraded converter</option><option>Transmission cooler</option><option>Converter + transmission cooler</option><option>Upgraded clutch</option><option>Built transmission</option><option>Other</option></select></label>
              </div>
              <label class="psi-v3__field"><span>Transmission details</span><input name="contact[Transmission details]" maxlength="500" placeholder="Converter, cooler, clutch or transmission work."></label>
            </article>
            <article class="psi-v3__spec-card">
              <h4><span>03</span>Differential</h4>
              <div class="psi-v3__grid">
                <label class="psi-v3__field"><span>Centre</span><select name="contact[Differential centre]"><option value="">Choose centre</option><option>Stock</option><option>Truetrac</option><option>Wavetrac</option><option>Other</option></select></label>
                <label class="psi-v3__field"><span>Gear ratio</span><input name="contact[Differential gear ratio]" maxlength="60" placeholder="e.g. 3.46 or Unknown"></label>
              </div>
            </article>
            <article class="psi-v3__spec-card psi-v3__spec-card--wide">
              <h4><span>04</span>Fuel system</h4>
              <div class="psi-v3__grid psi-v3__grid--three">
                <label class="psi-v3__field"><span>Fuel pump</span><select name="contact[Fuel pump]"><option value="">Choose pump</option><option>Stock</option><option>Upgraded</option><option>Unknown</option></select></label>
                <label class="psi-v3__field"><span>Injectors</span><select name="contact[Injectors]"><option value="">Choose injectors</option><option>Stock</option><option>Upgraded</option><option>Unknown</option></select></label>
                <label class="psi-v3__field"><span>Fuel for tuning</span><select name="contact[Fuel]"><option value="">Choose fuel</option><option>98 RON</option><option>E85</option><option>Flex fuel</option><option>Race fuel</option><option>Other</option></select></label>
              </div>
              <label class="psi-v3__field"><span>Fuel system details</span><input name="contact[Fuel system details]" maxlength="800" placeholder="Pump brand/model, injector brand/size and any supporting changes."></label>
            </article>
            <article class="psi-v3__spec-card">
              <h4><span>05</span>Intake & current tune</h4>
              <div class="psi-v3__grid">
                <label class="psi-v3__field"><span>Intake</span><select name="contact[Intake]"><option value="">Choose intake</option><option>Stock</option><option>Upgraded</option></select></label>
                <label class="psi-v3__field"><span>Previously tuned?</span><select name="contact[Previously tuned]"><option value="">Choose answer</option><option>No</option><option>Yes</option><option>Unknown</option></select></label>
              </div>
              <label class="psi-v3__field"><span>Intake / previous tuner details</span><input name="contact[Intake and previous tune details]" maxlength="800" placeholder="Intake brand/style and who previously tuned it."></label>
            </article>
            <article class="psi-v3__spec-card">
              <h4><span>06</span>Exhaust</h4>
              <div class="psi-v3__grid psi-v3__grid--three">
                <label class="psi-v3__field"><span>Type</span><select name="contact[Exhaust type]"><option value="">Choose type</option><option>Stock</option><option>Cat-back</option><option>Full system</option><option>Custom</option></select></label>
                <label class="psi-v3__field"><span>Size</span><select name="contact[Exhaust size]"><option value="">Choose size</option><option>Stock</option><option>2.5 inch</option><option>3 inch</option><option>3.5 inch</option><option>4 inch</option><option>Other</option></select></label>
                <label class="psi-v3__field"><span>Varex controlled?</span><select name="contact[Varex controlled]"><option value="">Choose answer</option><option>No</option><option>Yes</option><option>Unknown</option></select></label>
              </div>
              <label class="psi-v3__field"><span>Exact exhaust modifications</span><textarea name="contact[Exhaust modifications]" rows="3" placeholder="Headers, cats, brand, pipe size, mufflers and valve control."></textarea></label>
            </article>
            <article class="psi-v3__spec-card psi-v3__spec-card--wide">
              <h4><span>07</span>Camshaft</h4>
              <div class="psi-v3__grid">
                <label class="psi-v3__field"><span>Camshaft setup</span><select name="contact[Camshaft setup]"><option value="">Choose setup</option><option>Stock</option><option>Upgraded</option><option>Unknown</option></select></label>
                <label class="psi-v3__field"><span>Camshaft code or specifications</span><input name="contact[Camshaft details]" maxlength="1000" placeholder="Part number, duration, lift and LSA if known."></label>
              </div>
            </article>
          </div>
        </div>

        <div class="psi-v3__panel" data-psi-panel="plan" hidden>
          <div class="psi-v3__section-heading"><span>01</span><div><h3>Choose build areas</h3><p>Select every area you would like to discuss.</p></div></div>
          <div class="psi-v3__area-grid">
            {% assign psi_areas = 'Engine|Suspension|Exhaust|Intake|Repairs|Interior|Programming|Other' | split: '|' %}
            {% for area in psi_areas %}
              <label class="psi-v3__area"><input type="checkbox" name="contact[Plan area - {{ area }}]" value="Discuss" data-psi-area="{{ area | downcase }}"><span>{{ forloop.index | prepend: '0' }}</span><strong>{{ area }}</strong><b>+</b></label>
            {% endfor %}
          </div>

          <div class="psi-v3__area-details">
            <label class="psi-v3__field" data-psi-area-detail="engine" hidden><span>Engine</span><select name="contact[Plan - Engine]"><option value="">What would you like to discuss?</option><option>Health check or diagnosis</option><option>Naturally aspirated upgrade</option><option>Camshaft or valvetrain</option><option>Turbo or supercharger</option><option>Fuel or ignition support</option><option>Cooling, oiling or reliability</option><option>Engine build or rebuild</option><option>Not sure — I would like PSI advice</option><option>Other / not listed</option></select></label>
            <label class="psi-v3__field" data-psi-area-detail="suspension" hidden><span>Suspension</span><select name="contact[Plan - Suspension]"><option value="">What would you like to discuss?</option><option>Street handling package</option><option>Springs or dampers</option><option>Coilovers or ride height</option><option>Bushes or mounts</option><option>Sway bars or geometry</option><option>Track setup</option><option>Not sure — I would like PSI advice</option><option>Other / not listed</option></select></label>
            <label class="psi-v3__field" data-psi-area-detail="exhaust" hidden><span>Exhaust</span><select name="contact[Plan - Exhaust]"><option value="">What would you like to discuss?</option><option>Cat-back system</option><option>Headers or extractors</option><option>Downpipes</option><option>High-flow catalytic converters</option><option>Full or custom system</option><option>Valved or Varex system</option><option>Repair, noise or fitment concern</option><option>Not sure — I would like PSI advice</option><option>Other / not listed</option></select></label>
            <label class="psi-v3__field" data-psi-area-detail="intake" hidden><span>Intake</span><select name="contact[Plan - Intake]"><option value="">What would you like to discuss?</option><option>Filter or panel upgrade</option><option>Cold-air or OTR intake</option><option>Intake manifold or throttle body</option><option>Intercooler or charge piping</option><option>Forced-induction inlet</option><option>Not sure — I would like PSI advice</option><option>Other / not listed</option></select></label>
            <label class="psi-v3__field" data-psi-area-detail="repairs" hidden><span>Repairs</span><select name="contact[Plan - Repairs]"><option value="">What would you like to discuss?</option><option>Scan or diagnostics</option><option>Engine mechanical concern</option><option>Cooling or overheating concern</option><option>Driveline, clutch or transmission</option><option>Brakes</option><option>Steering or suspension repair</option><option>Electrical fault or warning light</option><option>General inspection</option><option>Not sure — I would like PSI advice</option><option>Other / not listed</option></select></label>
            <label class="psi-v3__field" data-psi-area-detail="interior" hidden><span>Interior</span><select name="contact[Plan - Interior]"><option value="">What would you like to discuss?</option><option>Gauges or displays</option><option>Switches or controls</option><option>Seats or mounting</option><option>Trim or fitment</option><option>Heat or noise management</option><option>Motorsport interior discussion</option><option>Not sure — I would like PSI advice</option><option>Other / not listed</option></select></label>
            <label class="psi-v3__field" data-psi-area-detail="programming" hidden><span>Programming</span><select name="contact[Plan - Programming]"><option value="">What would you like to discuss?</option><option>Engine ECU calibration</option><option>Transmission or TCU calibration</option><option>Diagnostics or supported coding</option><option>Flex-fuel or fuel setup</option><option>Supported feature configuration</option><option>Post-modification calibration</option><option>Not sure — I would like PSI advice</option><option>Other / not listed</option></select></label>
            <label class="psi-v3__field" data-psi-area-detail="other" hidden><span>Other</span><select name="contact[Plan - Other]"><option value="">What would you like to discuss?</option><option>Complete staged build</option><option>Parts matching or advice</option><option>Vehicle health or inspection</option><option>Track or motorsport preparation</option><option>Idea not listed</option><option>Not sure — I would like PSI advice</option></select></label>
          </div>

          <div class="psi-v3__section-heading psi-v3__section-heading--spaced"><span>02</span><div><h3>Shape the plan</h3><p>Give PSI the direction needed for a productive first conversation.</p></div></div>
          <div class="psi-v3__grid">
            <label class="psi-v3__field"><span>Intended use</span><select name="contact[Plan intended use]"><option value="">Choose an option</option><option>Daily or street use</option><option>Weekend or spirited driving</option><option>Drag use</option><option>Circuit or sprint use</option><option>Show or car meets</option><option>Mixed use</option><option>Other / not sure</option></select></label>
            <label class="psi-v3__field"><span>Main priority</span><select name="contact[Plan main priority]"><option value="">Choose an option</option><option>Reliability and vehicle health</option><option>Drivability and response</option><option>Power and torque</option><option>Handling</option><option>Sound</option><option>Comfort or appearance</option><option>Diagnosis or repair</option><option>Balanced staged build</option><option>I would like PSI guidance</option></select></label>
            <label class="psi-v3__field"><span>Planning stage</span><select name="contact[Plan stage]"><option value="">Choose an option</option><option>Exploring options</option><option>Parts already fitted or owned</option><option>Ready for a PSI inspection</option><option>Planning stages over time</option><option>Repair or baseline first</option><option>Not sure yet</option></select></label>
            <label class="psi-v3__field"><span>Timing</span><select name="contact[Plan timing]"><option value="">Choose an option</option><option>As soon as practical</option><option>Within 1–3 months</option><option>Within 3–6 months</option><option>Later or flexible</option><option>Research only</option></select></label>
            <label class="psi-v3__field"><span>Budget direction</span><select name="contact[Plan budget direction]"><option value="">Choose an option</option><option>I need PSI guidance</option><option>Essentials first</option><option>Stage the work over time</option><option>I have a budget range to discuss</option><option>Ready to discuss the full scope</option><option>Prefer not to say yet</option></select></label>
            <label class="psi-v3__field"><span>Budget note · Optional</span><input name="contact[Plan budget note]" maxlength="160" placeholder="Range or staging limit to discuss."></label>
          </div>
          <div class="psi-v3__grid">
            <label class="psi-v3__field"><span>Goal or concern · Optional</span><textarea name="contact[Plan goal]" rows="4" maxlength="360" placeholder="What would you like the vehicle to do, feel like or stop doing?"></textarea></label>
            <label class="psi-v3__field"><span>Current setup · Optional</span><textarea name="contact[Plan current setup]" rows="4" maxlength="360" placeholder="Current modifications, fitted parts or parts you already own."></textarea></label>
          </div>
        </div>

        <div class="psi-v3__customer">
          <div class="psi-v3__section-heading"><span>04</span><div><h3>You and your car</h3><p>These details let PSI respond to the right person about the right vehicle.</p></div></div>
          <div class="psi-v3__grid">
            <label class="psi-v3__field"><span>Full name</span><input name="contact[name]" autocomplete="name" required></label>
            <label class="psi-v3__field"><span>Email</span><input type="email" name="contact[email]" autocomplete="email" required></label>
            <label class="psi-v3__field"><span>Mobile</span><input type="tel" name="contact[phone]" autocomplete="tel" required></label>
            <label class="psi-v3__field"><span>Registration</span><input name="contact[Registration]" maxlength="20" required></label>
            <label class="psi-v3__field"><span>Year</span><input type="number" name="contact[Vehicle year]" min="1900" max="2030" required></label>
            <label class="psi-v3__field"><span>Make</span><input name="contact[Vehicle make]" maxlength="60" required></label>
            <label class="psi-v3__field"><span>Model</span><input name="contact[Vehicle model]" maxlength="80" required></label>
            <label class="psi-v3__field"><span>Preferred timing or date · Optional</span><input name="contact[Preferred date or timing]" placeholder="A date, month or flexible"></label>
          </div>
          <label class="psi-v3__consent"><input type="checkbox" required><span>I understand this is an enquiry. PSI will review the work and contact me to confirm availability and the next step.</span></label>
          <button class="psi-v3__submit" type="submit">Send enquiry <span>→</span></button>
          <p class="psi-v3__note">No payment is requested here. Your enquiry is sent securely through the PSI Shopify website.</p>
        </div>
      {% endform %}
    </div>

    <aside class="psi-v3__app" aria-labelledby="psi-v3-app-title">
      <p class="psi-v3__app-kicker"><span></span> PSI App · Coming Soon</p>
      <h3 id="psi-v3-app-title">Your garage.<br>Always with you.</h3>
      <p>Save your vehicles, request future bookings faster and keep your PSI customer history together in one secure portal.</p>
      <div class="psi-v3__phone" aria-hidden="true">
        <div class="psi-v3__speaker"></div><b>PSI Performance</b><small>MY GARAGE</small><strong>2017 Holden GTSR</strong><em>Bookings · History · Reports</em>
        <div><span>Book</span><span>Garage</span><span>Reports</span></div>
      </div>
      <ol><li><span>01</span>Save your vehicle details</li><li><span>02</span>Book faster next time</li><li><span>03</span>Access history and reports</li></ol>
      <a href="mailto:info@psiperformance.com.au?subject=PSI%20App%20Launch%20Updates">Join launch updates <span>→</span></a>
      <small>No app or account is required to send an enquiry today.</small>
    </aside>
  </div>
</section>

<style>
  .psi-v3 h2,.psi-v3__workspace h3,.psi-v3__workspace h4{color:#fff!important}.psi-v3__app h3{color:#050505!important}
  .psi-v3{--ice:#65cff8;--line:#303436;background:#000;color:#fff;padding:clamp(64px,8vw,120px) max(20px,6vw);font-family:var(--font-body-family,Arial,sans-serif);scroll-margin-top:20px;overflow:hidden}.psi-v3 *{box-sizing:border-box}.psi-v3 [hidden]{display:none!important}.psi-v3 p,.psi-v3 small,.psi-v3 span,.psi-v3 strong,.psi-v3 h2,.psi-v3 h3,.psi-v3 h4,.psi-v3 label{overflow-wrap:anywhere}.psi-v3__intro,.psi-v3__layout{width:min(1380px,100%);margin-inline:auto}.psi-v3__intro{display:grid;grid-template-columns:1.4fr .6fr;gap:clamp(32px,7vw,100px);align-items:end;margin-bottom:clamp(42px,6vw,76px)}.psi-v3__eyebrow{margin:0 0 12px;color:var(--ice);font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.psi-v3 h2{margin:0;font-size:clamp(38px,5vw,72px);line-height:.96;letter-spacing:-.045em;text-transform:uppercase}.psi-v3__intro>p{margin:0;color:#b9c0c4;line-height:1.7}.psi-v3__layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.35fr);gap:clamp(18px,3vw,38px);align-items:start}.psi-v3__workspace{min-width:0;padding:clamp(22px,4vw,46px);border:1px solid var(--line);background:#050505}.psi-v3__form{display:grid;gap:18px}.psi-v3__success{display:grid;gap:5px;padding:16px;border-left:3px solid var(--ice);background:#0b1a20}.psi-v3__choice{padding:22px;border:1px solid #495055;border-left:3px solid var(--ice);background:#0d0f10}.psi-v3__choice>p{margin:0 0 16px;font-size:11px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.psi-v3__choice-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.psi-v3__choice-card{position:relative;min-height:150px;display:grid;align-content:end;gap:7px;padding:20px;border:1px solid #747c80;background:#000;color:#fff;text-align:left;cursor:pointer}.psi-v3__choice-card>span{position:absolute;top:18px;right:18px;color:var(--ice);font-weight:900}.psi-v3__choice-card strong{font-size:15px;line-height:1.25;text-transform:uppercase}.psi-v3__choice-card small{color:#aab1b5;line-height:1.45}.psi-v3__choice-card:hover,.psi-v3__choice-card:focus,.psi-v3__choice-card.is-active{border-color:var(--ice);box-shadow:inset 0 3px 0 var(--ice);outline:none}.psi-v3__panel,.psi-v3__customer{display:grid;gap:24px;padding:clamp(22px,3vw,38px);border:1px solid var(--line);background:#080909}.psi-v3__section-heading{display:grid;grid-template-columns:48px minmax(0,1fr);gap:16px;align-items:start}.psi-v3__section-heading>span{width:48px;height:48px;display:grid;place-items:center;border:1px solid #2e7d9b;background:#0c1a20;color:var(--ice);font-size:11px;font-weight:900}.psi-v3__section-heading h3{margin:0;font-size:clamp(20px,2.2vw,32px);text-transform:uppercase}.psi-v3__section-heading p{margin:7px 0 0;color:#aab1b5;line-height:1.55}.psi-v3__section-heading--spaced{margin-top:18px;padding-top:30px;border-top:1px solid var(--line)}.psi-v3__grid,.psi-v3__area-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.psi-v3__grid--three{grid-template-columns:repeat(3,minmax(0,1fr))}.psi-v3__field{min-width:0;display:grid;align-content:start;gap:8px}.psi-v3__field>span,.psi-v3__confidence legend{font-size:11px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.psi-v3__field input,.psi-v3__field select,.psi-v3__field textarea{width:100%;min-width:0;min-height:50px;padding:13px 14px;border:1px solid #454b4e;border-radius:0;background:#020202;color:#fff;font:inherit;font-size:14px}.psi-v3__field textarea{resize:vertical;line-height:1.5}.psi-v3__field input::placeholder,.psi-v3__field textarea::placeholder{color:#8f999e;opacity:1}.psi-v3__field input:focus,.psi-v3__field select:focus,.psi-v3__field textarea:focus{border-color:var(--ice);box-shadow:0 0 0 3px rgba(101,207,248,.14);outline:none}.psi-v3__confidence{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0;padding:0;border:0}.psi-v3__confidence legend{grid-column:1/-1;margin-bottom:4px}.psi-v3__confidence label{display:grid;grid-template-columns:aut