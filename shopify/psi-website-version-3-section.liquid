  @media(max-width:1180px){.psi-v3__layout{grid-template-columns:1fr}.psi-v3__app{position:relative;top:auto;grid-template-columns:minmax(0,1fr) minmax(190px,.4fr)}.psi-v3__app .psi-v3__phone{grid-column:2;grid-row:1/span 4}.psi-v3__app ol,.psi-v3__app>a,.psi-v3__app>small{grid-column:1}.psi-v3__area-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.psi-v3{padding:58px 16px}.psi-v3__intro,.psi-v3__choice-grid,.psi-v3__grid,.psi-v3__grid--three,.psi-v3__confidence,.psi-v3__spec,.psi-v3__area-details,.psi-v3__app{grid-template-columns:1fr}.psi-v3__intro{gap:20px;margin-bottom:34px}.psi-v3__workspace{padding:18px}.psi-v3__choice,.psi-v3__panel,.psi-v3__customer{padding:20px}.psi-v3__app .psi-v3__phone,.psi-v3__app ol,.psi-v3__app>a,.psi-v3__app>small{grid-column:1;grid-row:auto}.psi-v3__choice-card{min-height:122px}.psi-v3__spec-card--wide{grid-column:auto}.psi-v3__field input,.psi-v3__field select,.psi-v3__field textarea{font-size:16px}}
  @media(max-width:460px){.psi-v3__area-grid{grid-template-columns:1fr}.psi-v3__section-heading{grid-template-columns:44px minmax(0,1fr)}.psi-v3__section-heading>span{width:44px;height:44px}}
