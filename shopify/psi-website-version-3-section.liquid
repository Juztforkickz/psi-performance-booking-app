<script>
  (function(){
    var root=document.getElementById('booking-panel');if(!root||root.dataset.psiReady)return;root.dataset.psiReady='true';
    var typeInput=root.querySelector('[data-psi-enquiry-type]');
    function setEnabled(container,enabled){container.querySelectorAll('input,select,textarea').forEach(function(field){field.disabled=!enabled;});}
    function showKind(kind){
      root.querySelectorAll('[data-psi-kind]').forEach(function(button){var active=button.dataset.psiKind===kind;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active));});
      root.querySelectorAll('[data-psi-panel]').forEach(function(panel){var active=panel.dataset.psiPanel===kind;panel.hidden=!active;setEnabled(panel,active);});
      typeInput.value=kind==='service'?'Service':kind==='dyno'?'Dyno Tuning':'Plan Builder';
    }
    root.querySelectorAll('[data-psi-kind]').forEach(function(button){button.addEventListener('click',function(){showKind(button.dataset.psiKind);});});
    root.querySelectorAll('[data-psi-confidence]').forEach(function(radio){radio.addEventListener('change',function(){var spec=root.querySelector('[data-psi-spec]');var visible=radio.dataset.psiConfidence==='known'&&radio.checked;spec.hidden=!visible;setEnabled(spec,visible);});});
    root.querySelectorAll('[data-psi-area]').forEach(function(box){box.addEventListener('change',function(){var detail=root.querySelector('[data-psi-area-detail="'+box.dataset.psiArea+'"]');detail.hidden=!box.checked;setEnabled(detail,box.checked);});});
    document.querySelectorAll('a').forEach(function(link){var label=(link.textContent||'').trim().toLowerCase();if(label==='contact'){link.setAttribute('href','#booking-panel');}if(label==='book a free consultation'||label==='book a free consulation'||label==='book an appointment'){link.textContent='Book an Appointment';link.setAttribute('href','#booking-panel');}});
    showKind('service');
    var spec=root.querySelector('[data-psi-spec]');setEnabled(spec,false);
  })();
</script>
