rder:1px solid var(--ice);border-top:5px solid var(--ice);background:linear-gradient(145deg,#fff,#dbe3e7);color:#050505;box-shadow:0 25px 70px rgba(0,0,0,.45)}.psi-v3__app-kicker{width:max-content;max-width:100%;display:flex;align-items:center;gap:7px;margin:0;padding:7px 10px;border:1px solid #111;border-radius:999px;font-size:10px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.psi-v3__app-kicker span{width:7px;height:7px;flex:0 0 7px;border-radius:50%;background:var(--ice);box-shadow:0 0 10px var(--ice)}.psi-v3__app h3{margin:0;font-size:clamp(25px,2.4vw,38px);line-height:1;text-transform:uppercase}.psi-v3__app>p:not(.psi-v3__app-kicker){margin:0;color:#394044;line-height:1.6}.psi-v3__phone{width:min(245px,90%);justify-self:center;display:grid;gap:9px;padding:15px;border:3px solid #050505;border-radius:28px;background:#eeeae2;box-shadow:0 0 0 3px rgba(101,207,248,.7),0 18px 42px rgba(0,0,0,.25)}.psi-v3__speaker{width:56px;height:5px;margin:0 auto 8px;border-radius:99px;background:#111}.psi-v3__phone>b{text-transform:uppercase}.psi-v3__phone small{margin-top:7px;font-size:9px;font-weight:900}.psi-v3__phone strong{padding:16px;background:#070707;color:#fff}.psi-v3__phone em{font-size:9px;font-style:normal}.psi-v3__phone>div:last-child{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.psi-v3__phone>div span{padding:8px 2px;border:1px solid #bbb;font-size:8px;font-weight:900;text-align:center;text-transform:uppercase}.psi-v3__app ol{margin:0;padding:0;list-style:none}.psi-v3__app li{display:grid;grid-template-columns:30px 1fr;gap:8px;padding:11px 0;border-bottom:1px solid #b8c0c4;font-size:12px;font-weight:750}.psi-v3__app li span{color:#155d78;font-size:10px;font-weight:900}.psi-v3__app>a{display:flex;justify-content:space-between;gap:14px;padding:15px 17px;background:#050505;color:#fff;font-size:11px;font-weight:900;letter-spacing:.06em;text-decoration:none;text-transform:uppercase}.psi-v3__app>a:hover,.psi-v3__app>a:focus{box-shadow:0 0 0 3px