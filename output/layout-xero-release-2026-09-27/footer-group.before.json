amp(38px, 5vw, 59px)/.9 \"Barlow Condensed\", sans-serif; }\n.metric small { margin-top: 6px; color: #777d85; font-size: 11px; font-weight: 600; }\n.stage-card > p { grid-column: 1 / -1; align-self: end; margin: 0; padding-top: 18px; color: #7f858d; border-top: 1px solid #30343a; font-size: 11px; line-height: 1.5; }\n.custom-output { grid-column: 1 / -1; align-self: center; }\n.custom-output span, .custom-output strong, .custom-output small { display: block; }\n.custom-output span { color: #92979f; font-size: 11px; text-transform: uppercase; }\n.custom-output strong { margin: 8px 0; color: white; font: 800 38px/.9 \"Barlow Condensed\", sans-serif; }\n.stage-four .custom-output strong { color: var(--accent); }\n.custom-output small { max-width: 320px; color: #777d85; line-height: 1.5; }\n.result-footer { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 26px 32px; color: white; background: #050608; border-top: 1px solid #303238; }\n.result-footer p { margin: 0; font-size: 13px; }\n.result-footer p strong { display: block; margin-bottom: 3px; font-size: 16px; }\n.result-footer a { flex: 0 0 auto; padding: 13px 17px; color: #121212; background: white; text-decoration: none; font-size: 12px; font-weight: 700; text-transform: uppercase; }\n.disclaimer { margin-top: 24px; padding: 19px 22px; color: #6b7078; background: #e9e9e6; border-left: 3px solid #aaadb1; font-size: 11px; line-height: 1.65; }\nfooter { display: flex; justify-content: space-between; align-items: center; gap: 28px; padding: 35px clamp(22px, 5vw, 80px); color: #858a91; background: #08090b; border-top: 1px solid #24272b; font-size: 10px; letter-spacing: .04em; }\nfooter > div { display: flex; align-items: center; gap: 18px; }\nfooter img { width: auto; height: 34px; object-fit: contain; }\n.footer-contact { justify-content: flex-end; }\n.footer-contact a { color: #c3c6ca; text-decoration: none; }\n.footer-contact a:hover { color: white; }\n\n@media (max-width: 850px) {\n  .catalogue-strip { grid-template-columns: 1fr 1fr; }\n  .catalogue-strip p { border-top: 1px solid #2c2f34; }\n  .vehicle-form { grid-template-columns: 1fr 1fr; }\n  .vehicle-form .select-field { grid-column: auto; }\n  .vehicle-form .vehicle-type-field { grid-column: 1 / -1; }\n  .stage-grid { grid-template-columns: 1fr; }\n  .stage-grid .factory, .stage-grid .stage-one, .stage-grid .stage-two, .stage-grid .stage-three, .stage-grid .stage-four { grid-column: auto; }\n  .stage-card { min-height: 270px; }\n  .hero::after { width: 90%; }\n}\n@media (max-width: 560px) {\n  .topbar span:last-child { display: none; }\n  .site-header { height: 74px; }\n  .brand img { height: 38px; }\n  .header-cta { padding: 10px; font-size: 0; }\n  .header-cta span { font-size: 20px; }\n  .hero { min-height: 540px; }\n  h1 { font-size: 58px; }\n  .hero-stats { display: grid; grid-template-columns: 1fr 1fr; }\n  .catalogue-strip { grid-template-columns: 1fr; }\n  .catalogue-strip > div { border-right: 0; border-bottom: 1px solid #2c2f34; }\n  .vehicle-form { padding: 20px; }\n  .vehicle-form { grid-template-columns: 1fr; }\n  .estimator-section { padding-top: 72px; }\n  .results-header, .result-footer { align-items: flex-start; flex-direction: column; }\n  .stage-grid { padding: 12px; }\n  .unit-switch { padding-right: 12px; }\n  footer, footer > div, .footer-contact { align-items: flex-start; flex-direction: column; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n}\n#psi-estimator #page-title .potential-word { display: inline-block; white-space: nowrap !important; word-break: keep-all !important; overflow-wrap: normal !important; font-size: .72em; }\n</style><script>// Cars and vans only. Heavy trucks, motorcycles, agricultural vehicles and machinery are excluded.\n// Australian-market records are published only where make/model/badge/series/engine data has been verified.\nwindow.MANUFACTURERS = [\n  \"Alfa Romeo\", \"Aston Martin\", \"Audi\", \"Bentley\", \"BMW\", \"Bugatti\",\n  \"Chevrolet\", \"Chrysler\", \"Dodge\", \"Ferrari\", \"Fiat\", \"Ford\", \"Holden\", \"HSV\",\n  \"Honda\", \"Hyundai\", \"Infiniti\", \"Isuzu\", \"Iveco\", \"JAC\", \"Jaguar\", \"Jeep\",\n  \"Kia\", \"Lamborghini\", \"Land Rover\", \"LDV\", \"Lexus\", \"Lotus\", \"Maserati\",\n  \"Mazda\", \"McLaren\", \"Mercedes-Benz\", \"MG\", \"MINI\", \"Mitsubishi\", \"Nissan\",\n  \"Peugeot\", \"Pontiac\", \"Porsche\", \"Renault\", \"Rolls-Royce\", \"Saab\", \"Subaru\",\n  \"Suzuki\", \"Toyota\", \"Volkswagen\", \"Volvo\"\n];\n\nwindow.CATALOG_META = {\n  vehicleType: \"Cars & vans\",\n  manufacturerCount: window.MANUFACTURERS.length,\n  verifiedManufacturerCount: 2\n};\n\n// Factory figures are engine output. PSI wheel/hub results remain explicitly labelled in psiEvidence.\nwindow.VEHICLE_DATA = [\n  { make: \"Holden\", model: \"Ute\", submodel: \"SS · VU Series I\", years: \"2000–2001\", engine: \"5.7L GEN III V8 · LS1\", stockPower: 225, stockTorque: 460, stage1Power: 245, stage1Torque: 500, stage2Power: 260, stage2Torque: 525, psiEvidence: \"VERIFIED PSI RESULT · VCM alloy OTR + MAFless tune · 280 rwkW. Factory engine output and rear-wheel output are not directly compared.\" },\n  { make: \"Holden\", model: \"Ute\", submodel: \"SS · VU Series II\", years: \"2001–2002\", engine: \"5.7L GEN III V8 · LS1\", stockPower: 225, stockTorque: 460, stage1Power: 245, stage1Torque: 500, stage2Power: 260, stage2Torque: 525, psiEvidence: \"VERIFIED PSI RESULT · VCM alloy OTR + MAFless tune · 280 rwkW. The exact VU series in the PSI post was not stated, so this is platform evidence rather than a series-specific claim.\" },\n  { make: \"Holden\", model: \"Commodore\", submodel: \"SS / SS V / SS V Redline · VF Series II\", years: \"MY16–MY17 · 2015–2017\", engine: \"6.2L GEN IV V8 · LS3\", stockPower: 304, stockTorque: 570, stage1Power: 325, stage1Torque: 600, stage2Power: 350, stage2Torque: 630 },\n  { make: \"Holden\", model: \"Calais\", submodel: \"V · VF Series I\", years: \"MY14–MY15 · 2013–2015\", engine: \"6.0L GEN IV V8 · L77\", stockPower: 260, stockTorque: 517, stage1Power: 280, stage1Torque: 545, stage2Power: 300, stage2Torque: 570, psiEvidence: \"VERIFIED PSI BUILD · camshaft + OTR + exhaust L77 combination. No numerical final result was published.\" },\n  { make: \"Mercedes-Benz\", model: \"C-Class\", submodel: \"Mercedes-AMG C 63 S Coupé · C205\", years: \"MY16–MY21 · 2016–2021\", engine: \"4.0L twin-turbo V8 · M177\", stockPower: 375, stockTorque: 700, stage1Power: 440, stage1Torque: 850, stage2Power: 475, stage2Torque: 900, psiEvidence: \"VERIFIED PSI RESULT · Stage 2 downpipes, intakes and calibration · 544 rwhp and 974 Nm at the hubs. Factory engine and hub figures remain separately labelled.\" },\n  { make: \"Mercedes-Benz\", model: \"E-Class\", submodel: \"Mercedes-AMG E 63 S 4MATIC+ · W213\", years: \"MY18–MY23 · 2017–2023\", engine: \"4.0L twin-turbo V8 · M177\", stockPower: 450, stockTorque: 850, stage1Power: 500, stage1Torque: 950, stage2Power: 540, stage2Torque: 1050, psiEvidence: \"VERIFIED PSI RESULT · Stage 2 · 690 awhp and 1,266 Nm. The published post did not state the torque measurement basis.\" },\n\n  // Preview catalogue: factory baselines were selected from public Australian-market manufacturer material.\n  // Stage values below are PSI estimation-model placeholders, not copied supplier figures or claimed dyno outcomes.\n  { make: \"Audi\", model: \"RS 3\", submodel: \"Sportback / Sedan · 8Y\", years: \"MY22–MY24 · 2022–2024\", engine: \"2.5L five-cylinder turbo · DAZA/DNWA\", stockPower: 294, stockTorque: 500, stage1Power: 355, stage1Torque: 600, stage2Power: 385, stage2Torque: 650, resultType: \"modelled\", estimateNote: \"Preview model for a 98 RON calibration. Supporting hardware and transmission condition must be assessed before quoting.\" },\n  { make: \"BMW\", model: \"M3\", submodel: \"Competition M xDrive · G80 LCI\", years: \"MY25–MY26 · 2025–2026\", engine: \"3.0L twin-turbo inline-six · S58\", stockPower: 390, stockTorque: 650, stage1Power: 470, stage1Torque: 780, stage2Power: 500, stage2Torque: 820, resultType: \"modelled\", estimateNote: \"Preview model for premium fuel with software and appropriate supporting hardware. Final output depends on fuel, transmission and cooling configuration.\" },\n  { make: \"Chevrolet\", model: \"Corvette\", submodel: \"C5 · LS1\", years: \"1997–2004\", engine: \"5.7L V8 · LS1\", stockPower: 257, stockTorque: 475, stage1Power: 280, stage1Torque: 500, stage2Power: 300, stage2Torque: 525, resultType: \"psi-informed\", psiEvidence: \"PSI PUBLISHED BUILD REFERENCE · C5 Corvette with cylinder-head, camshaft, gearbox/converter, clutch, OTR and custom calibration. No numerical dyno result was published.\", estimateNote: \"Preview figures are a mild naturally aspirated estimate only; the PSI build referenced is a higher-level custom combination.\" },\n  { make: \"Ford\", model: \"Mustang\", submodel: \"GT · FN\", years: \"MY18–MY23 · 2018–2023\", engine: \"5.0L V8 · Coyote\", stockPower: 339, stockTorque: 556, stage1Power: 360, stage1Torque: 580, stage2Power: 385, stage2Torque: 610, resultType: \"modelled\", estimateNote: \"Preview model for a naturally aspirated 98 RON combination. OTR/intake and exhaust choice affect the final calibration.\" },\n  { make: \"Ford\", model: \"Ranger\", submodel: \"Raptor · PY\", years: \"MY23–MY25 · 2023–2025\", engine: \"3.0L twin-turbo V6 · EcoBoost\", stockPower: 292, stockTorque: 583, stage1Power: 330, stage1Torque: 650, stage2Power: 355, stage2Torque: 680, resultType: \"modelled\", estimateNote: \"Preview model for premium fuel. Final result depends on hardware, intercooling and intended towing or off-road use.\" },\n  { make: \"Holden\", model: \"Commodore\", submodel: \"SS · VY\", years: \"2002–2004\", engine: \"5.7L GEN III V8 · LS1\", stockPower: 235, stockTorque: 465, stage1Power: 255, stage1Torque: 495, stage2Power: 270, stage2Torque: 525, resultType: \"psi-informed\", psiEvidence: \"PSI PUBLISHED BUILD REFERENCE · VCM plastic MAFless OTR, plugs, fuel filter, engine and transmission calibration. No numerical dyno result was published.\", estimateNote: \"Preview model informed by the published PSI package. Vehicle condition and previous modifications must be checked.\" },\n  { make: \"HSV\", model: \"ClubSport\", submodel: \"R8 / R8 Tourer · GEN-F\", years: \"MY15 · 2014–2015\", engine: \"6.2L GEN IV V8 · LS3\", stockPower: 340, stockTorque: 570, stage1Power: 365, stage1Torque: 600, stage2Power: 390, stage2Torque: 630, resultType: \"modelled\", estimateNote: \"Preview naturally aspirated model based on the 340 kW SV Enhanced specification. Final output depends on intake, exhaust, fuel and vehicle condition.\" },\n  { make: \"HSV\", model: \"ClubSport\", submodel: \"R8 / R8 Tourer LSA · GEN-F2\", years: \"MY16 · 2016\", engine: \"6.2L supercharged V8 · LSA\", stockPower: 400, stockTorque: 671, stage1Power: 440, stage1Torque: 750, stage2Power: 470, stage2Torque: 790, resultType: \"modelled\", estimateNote: \"Preview supercharged model. Cooling, fuel quality, transmission and drivetrain condition must be assessed before quoting.\" },\n  { make: \"HSV\", model: \"Maloo\", submodel: \"R8 · GEN-F\", years: \"MY14–MY15 · 2013–2015\", engine: \"6.2L GEN IV V8 · LS3\", stockPower: 325, stockTorque: 550, stage1Power: 350, stage1Torque: 580, stage2Power: 375, stage2Torque: 615, resultType: \"modelled\", estimateNote: \"Preview naturally aspirated ute model. Final output depends on intake, exhaust, fuel and vehicle condition.\" },\n  { make: \"HSV\", model: \"Maloo\", submodel: \"R8 SV Enhanced · GEN-F\", years: \"MY14–MY15 · 2013–2015\", engine: \"6.2L GEN IV V8 · LS3\", stockPower: 340, stockTorque: 570, stage1Power: 365, stage1Torque: 600, stage2Power: 390, stage2Torque: 630, resultType: \"modelled\", estimateNote: \"Preview naturally aspirated ute model for the SV Enhanced factory specification. Final output depends on intake, exhaust, fuel and vehicle condition.\" },\n  { make: \"HSV\", model: \"GTS\", submodel: \"GTS Sedan · GEN-F\", years: \"MY14–MY17 · 2013–2017\", engine: \"6.2L supercharged V8 · LSA\", stockPower: 430, stockTorque: 740, stage1Power: 470, stage1Torque: 810, stage2Power: 500, stage2Torque: 850, resultType: \"modelled\", estimateNote: \"Preview supercharged model. The GTS already has substantial factory hardware; final package suitability and road-use requirements need workshop assessment.\" },\n  { make: \"HSV\", model: \"GTSR\", submodel: \"GTSR W1 · GEN-F2\", years: \"MY17 · 2017\", engine: \"6.2L supercharged V8 · LS9\", stockPower: 474, stockTorque: 815, stage1Power: 495, stage1Torque: 845, stage2Power: 515, stage2Torque: 875, resultType: \"modelled\", estimateNote: \"Preview only for this limited-production model. Any package should be quoted individually after inspecting the vehicle, fuel system, drivetrain and intended use.\" },\n  { make: \"Hyundai\", model: \"i30\", submodel: \"N / N Premium · PD facelift\", years: \"MY21–MY24 · 2021–2024\", engine: \"2.0L turbo petrol · Theta-II\", stockPower: 206, stockTorque: 392, stage1Power: 235, stage1Torque: 450, stage2Power: 255, stage2Torque: 480, resultType: \"psi-informed\", psiEvidence: \"PSI PUBLISHED BUILD REFERENCE · High-flow intake, turbo-back exhaust, Varex rear mufflers and calibration. The result was described but no numerical dyno figure was published.\", estimateNote: \"Preview Stage 2 model only. The listed PSI hardware package is used as a package reference, not as a claim of measured output.\" },\n  { make: \"Isuzu\", model: \"D-Max\", submodel: \"LS-U / X-TERRAIN · RG\", years: \"MY21–MY24 · 2021–2024\", engine: \"3.0L turbo-diesel · 4JJ3\", stockPower: 140, stockTorque: 450, stage1Power: 170, stage1Torque: 520, stage2Power: 180, stage2Torque: 550, resultType: \"modelled\", estimateNote: \"Preview diesel model. Towing use, EGT management and emissions compliance need to be considered for the final package.\" },\n  { make: \"Mercedes-Benz\", model: \"A-Class\", submodel: \"Mercedes-AMG A 45 S 4MATIC+ · W177\", years: \"MY20–MY24 · 2020–2024\", engine: \"2.0L turbo four-cylinder · M139\", stockPower: 310, stockTorque: 500, stage1Power: 360, stage1Torque: 600, stage2Power: 390, stage2Torque: 650, resultType: \"modelled\", estimateNote: \"Preview model for premium fuel and a suitable supporting-hardware package. Final calibration depends on fuel and transmission protection limits.\" },\n  { make: \"Mitsubishi\", model: \"Triton\", submodel: \"GLX-R / GLS / GSR · MR\", years: \"MY20–MY23 · 2020–2023\", engine: \"2.4L turbo-diesel · 4N15\", stockPower: 133, stockTorque: 430, stage1Power: 160, stage1Torque: 500, stage2Power: 170, stage2Torque: 520, resultType: \"modelled\", estimateNote: \"Preview diesel model. Final calibration needs to account for intended load, towing and emissions equipment.\" },\n  { make: \"Nissan\", model: \"Patrol\", submodel: \"Ti / Ti-L · Y62 Series 5\", years: \"MY20–MY24 · 2020–2024\", engine: \"5.6L V8 · VK56VD\", stockPower: 298, stockTorque: 560, stage1Power: 320, stage1Torque: 590, stage2Power: 340, stage2Torque: 620, resultType: \"modelled\", estimateNote: \"Preview naturally aspirated model. Intake, exhaust, fuel quality and vehicle accessories all influence final output.\" },\n  { make: \"Subaru\", model: \"WRX\", submodel: \"RS / tS · VB\", years: \"MY22–MY24 · 2022–2024\", engine: \"2.4L turbo boxer four-cylinder · FA24\", stockPower: 202, stockTorque: 350, stage1Power: 230, stage1Torque: 420, stage2Power: 250, stage2Torque: 460, resultType: \"modelled\", estimateNote: \"Preview model for premium fuel. Final output and reliability requirements depend on fuel, intake, exhaust and cooling configuration.\" },\n  { make: \"Toyota\", model: \"GR Yaris\", submodel: \"GR Yaris · GXPA16R\", years: \"MY21–MY24 · 2021–2024\", engine: \"1.6L turbo three-cylinder · G16E-GTS\", stockPower: 200, stockTorque: 370, stage1Power: 240, stage1Torque: 440, stage2Power: 265, stage2Torque: 480, resultType: \"modelled\", estimateNote: \"Preview model for a 98 RON calibration. Driveline, fuel-system and cooling requirements must be confirmed before Stage 2.\" },\n  { make: \"Volkswagen\", model: \"Golf\", submodel: \"R hatch · Mk8\", years: \"MY22–MY24 · 2022–2024\", engine: \"2.0L turbo four-cylinder · EA888\", stockPower: 235, stockTorque: 400, stage1Power: 290, stage1Torque: 500, stage2Power: 320, stage2Torque: 550, resultType: \"modelled\", estimateNote: \"Preview model for premium fuel. DSG service condition, intercooling and hardware selection need to be checked before quoting.\" },\n  { make: \"Volkswagen\", model: \"Golf\", submodel: \"R wagon · Mk8\", years: \"MY22–MY24 · 2022–2024\", engine: \"2.0L turbo four-cylinder · EA888\", stockPower: 235, stockTorque: 420, stage1Power: 290, stage1Torque: 520, stage2Power: 320, stage2Torque: 560, resultType: \"modelled\", estimateNote: \"Preview model for premium fuel. DSG service condition, intercooling and hardware selection need to be checked before quoting.\" },\n\n  { make: \"Audi\", model: \"RS Q3\", submodel: \"RS Q3 / Sportback · F3\", years: \"MY22–MY24 · 2022–2024\", engine: \"2.5L five-cylinder turbo · DAZA/DNWA\", stockPower: 294, stockTorque: 500, stage1Power: 355, stage1Torque: 600, stage2Power: 385, stage2Torque: 650, resultType: \"modelled\", estimateNote: \"Preview model for a 98 RON calibration. Transmission service history, cooling and supporting hardware need to be checked before quoting.\" },\n  { make: \"Hyundai\", model: \"i20\", submodel: \"N · BC3\", years: \"MY22–MY25 · 2022–2025\", engine: \"1.6L turbo petrol · SmartStream G1.6 T-GDi\", stockPower: 150, stockTorque: 275, stage1Power: 180, stage1Torque: 340, stage2Power: 195, stage2Torque: 370, resultType: \"modelled\", estimateNote: \"Preview model for premium fuel. Hardware selection, clutch condition and intended use must be checked before a Stage 2 recommendation.\" },\n  { make: \"Isuzu\", model: \"MU-X\", submodel: \"LS-U / LS-T · RJ\", years: \"MY21–MY25 · 2021–2025\", engine: \"3.0L turbo-diesel · 4JJ3\", stockPower: 140, stockTorque: 450, stage1Power: 170, stage1Torque: 520, stage2Power: 180, stage2Torque: 550, resultType: \"modelled\", estimateNote: \"Preview diesel model. Towing load, EGT management and emissions compliance must be considered for the final package.\" },\n  { make: \"Nissan\", model: \"Navara\", submodel: \"ST-X / PRO-4X · D23\", years: \"MY21–MY25 · 2021–2025\", engine: \"2.3L twin-turbo diesel · YS23DDTT\", stockPower: 140, stockTorque: 450, stage1Power: 170, stage1Torque: 540, stage2Power: 180, stage2Torque: 570, resultType: \"modelled\", estimateNote: \"Preview diesel model. Final calibration must account for towing, exhaust temperature, emissions equipment and drivetrain condition.\" },\n  { make: \"Subaru\", model: \"BRZ\", submodel: \"S / tS · ZD\", years: \"MY22–MY26 · 2022–2026\", engine: \"2.4L naturally aspirated boxer four-cylinder · FA24\", stockPower: 174, stockTorque: 250, stage1Power: 182, stage1Torque: 260, stage2Power: 192, stage2Torque: 275, resultType: \"modelled\", estimateNote: \"Preview naturally aspirated model. Final output depends on fuel, intake/exhaust hardware and whether road-use compliance is retained.\" },\n  { make: \"Toyota\", model: \"HiLux\", submodel: \"SR5 / Rogue · 4x4 automatic\", years: \"MY21–MY25 · 2021–2025\", engine: \"2.8L turbo-diesel · 1GD-FTV\", stockPower: 150, stockTorque: 500, stage1Power: 175, stage1Torque: 580, stage2Power: 185, stage2Torque: 610, resultType: \"modelled\", estimateNote: \"Preview diesel model. Towing, EGT management and emissions equipment must be assessed before a final package is quoted.\" },\n  { make: \"Toyota\", model: \"LandCruiser\", submodel: \"300 Series · FJA300\", years: \"MY22–MY25 · 2022–2025\", engine: \"3.3L twin-turbo V6 diesel · F33A-FTV\", stockPower: 227, stockTorque: 700, stage1Power: 265, stage1Torque: 800, stage2Power: 280, stage2Torque: 850, resultType: \"modelled\", estimateNote: \"Preview diesel model. Final package must account for towing, thermal management, vehicle mass, emissions equipment and intended off-road use.\" },\n  { make: \"Volkswagen\", model: \"Amarok\", submodel: \"Style / Aventura · NF\", years: \"MY23–MY25 · 2023–2025\", engine: \"3.0L V6 turbo-diesel · TDI600\", stockPower: 184, stockTorque: 600, stage1Power: 215, stage1Torque: 700, stage2Power: 225, stage2Torque: 730, resultType: \"modelled\", estimateNote: \"Preview diesel model. Towing use, transmission condition, emissions equipment and temperature management must be assessed before quoting.\" }\n];\n</script><script>(() => {\n  const data = window.VEHICLE_DATA || [];\n  const form = document.querySelector(\"#vehicle-form\");\n  const fields = {\n    make: document.querySelector(\"#manufacturer\"),\n    model: document.querySelector(\"#model\"),\n    submodel: document.querySelector(\"#submodel\"),\n    years: document.querySelector(\"#year\"),\n    engine: document.querySelector(\"#engine\")\n  };\n  const results = document.querySelector(\"#results\");\n  const emptyState = document.querySelector(\"#empty-state\");\n  const emptyTitle = document.querySelector(\"#empty-title\");\n  const emptyCopy = document.querySelector(\"#empty-copy\");\n  const unitButtons = [...document.querySelectorAll(\"[data-units]\")];\n  let selectedVehicle = null;\n  let currentUnits = \"metric\";\n\n  const unique = values => [...new Set(values)].sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));\n\n  function setOptions(select, values, prompt) {\n    select.replaceChildren(new Option(prompt, \"\"));\n    values.forEach(value => select.add(new Option(value, value)));\n    select.disabled = values.length === 0;\n  }\n\n  function resetAfter(key) {\n    const order = [\"make\", \"model\", \"submodel\", \"years\", \"engine\"];\n    order.slice(order.indexOf(key) + 1).forEach(next => {\n      const labels = { model: \"Select model\", submodel: \"Select sub-model\", years: \"Select year / series\", engine: \"Select engine\" };\n      setOptions(fields[next], [], labels[next]);\n    });\n    selectedVehicle = null;\n    results.hidden = true;\n    emptyState.hidden = false;\n  }\n\n  function setEmptyState(title, copy, variant = \"default\") {\n    emptyTitle.textContent = title;\n    emptyCopy.textContent = copy;\n    emptyState.dataset.variant = variant;\n    emptyState.hidden = false;\n  }\n\n  const manufacturers = window.MANUFACTURERS || unique(data.map(item => item.make));\n  setOptions(fields.make, manufacturers, \"Select manufacturer\");\n\n  fields.make.addEventListener(\"change\", () => {\n    resetAfter(\"make\");\n    const models = unique(data.filter(v => v.make === fields.make.value).map(v => v.model));\n    setOptions(fields.model, models, models.length ? \"Select model\" : \"Catalogue validation in progress\");\n    if (!fields.make.value) {\n      setEmptyState(\"YOUR RESULTS WILL APPEAR HERE\", \"Complete the vehicle selections above to see estimated power and torque gains.\");\n    } else if (!models.length) {\n      setEmptyState(`${fields.make.value.toUpperCase()} IS IN THE ROLLOUT`, \"This manufacturer is included in the PSI cars and vans catalogue. Its Australian-market model, year and engine records are still being validated before results are published.\", \"pending\");\n    } else {\n      setEmptyState(\"CONTINUE YOUR VEHICLE SELECTION\", `Verified ${fields.make.value} records are available. Select the model, sub-model, year and engine to view an estimate.`, \"ready\");\n    }\n  });\n\n  fields.model.addEventListener(\"change\", () => {\n    resetAfter(\"model\");\n    setOptions(fields.submodel, unique(data.filter(v => v.make === fields.make.value && v.model === fields.model.value).map(v => v.submodel)), \"Select sub-model\");\n    if (fields.model.value) setEmptyState(\"SELECT THE EXACT VARIANT\", \"Choose the badge and series that matches the vehicle. This prevents figures from being shown against the wrong engine package.\", \"ready\");\n  });\n\n  fields.submodel.addEventListener(\"change\", () => {\n    resetAfter(\"submodel\");\n    setOptions(fields.years, unique(data.filter(v => v.make === fields.make.value && v.model === fields.model.value && v.submodel === fields.submodel.value).map(v => v.years)), \"Select year / series\");\n    if (fields.submodel.value) setEmptyState(\"NARROW IT DOWN BY YEAR\", \"Select the matching model year or series, then confirm the engine to reveal the estimate.\", \"ready\");\n  });\n\n  fields.years.addEventListener(\"change\", () => {\n    resetAfter(\"years\");\n    setOptions(fields.engine, unique(data.filter(v => v.make === fields.make.value && v.model === fields.model.value && v.submodel === fields.submodel.value && v.years === fields.years.value).map(v => v.engine)), \"Select engine\");\n  });\n\n  fields.engine.addEventListener(\"change\", () => {\n    selectedVehicle = data.find(v => v.make === fields.make.value && v.model === fields.model.value && v.submodel === fields.submodel.value && v.years === fields.years.value && v.engine === fields.engine.value) || null;\n    if (selectedVehicle) showResults();\n  });\n\n  function converted(key) {\n    const value = selectedVehicle[key];\n    if (currentUnits === \"metric\") return Math.round(value);\n    return Math.round(value * (key.toLowerCase().includes(\"power\") ? 1.34102 : 0.737562));\n  }\n\n  function renderMetrics() {\n    [\"stockPower\", \"stockTorque\", \"stage1Power\", \"stage1Torque\", \"stage2Power\", \"stage2Torque\"].forEach(key => {\n      document.querySelector(`[data-value=\"${key}\"]`).textContent = converted(key).toLocaleString(\"en-AU\");\n    });\n    document.querySelectorAll(\"[data-power-unit]\").forEach(el => el.textContent = currentUnits === \"metric\" ? \"kW\" : \"hp\");\n    document.querySelectorAll(\"[data-torque-unit]\").forEach(el => el.textContent = currentUnits === \"metric\" ? \"Nm\" : \"lb-ft\");\n  }\n\n  function showResults() {\n    document.querySelector(\"#result-vehicle\").textContent = `${selectedVehicle.make} ${selectedVehicle.model} ${selectedVehicle.submodel} · ${selectedVehicle.years}`;\n    document.querySelector(\"#result-engine\").textContent = selectedVehicle.engine;\n    const status = document.querySelector(\"#result-status\");\n    const statusDetails = {\n      modelled: [\"PSI ESTIMATED PREVIEW\", \"Factory baseline plus PSI estimation model. Not a measured dyno result.\"],\n      \"psi-informed\": [\"PSI PACKAGE REFERENCE + ESTIMATE\", \"PSI-published hardware package used as context; stage figures remain estimates.\"],\n      \"psi-tested\": [\"PSI TESTED REFERENCE\", \"PSI-posted dyno outcome is shown separately below; estimator values remain indicative.\"]\n    };\n    const currentStatus = statusDetails[selectedVehicle.resultType || (selectedVehicle.psiEvidence ? \"psi-tested\" : \"modelled\")];\n    status.textContent = `${currentStatus[0]} · ${selectedVehicle.estimateNote || currentStatus[1]}`;\n    const evidence = document.querySelector(\"#psi-evidence\");\n    if (selectedVehicle.psiEvidence) {\n      evidence.textContent = selectedVehicle.psiEvidence;\n      evidence.hidden = false;\n    } else {\n      evidence.textContent = \"\";\n      evidence.hidden = true;\n    }\n    document.querySelector('[data-gain=\"stage1\"]').textContent = `+${Math.round((selectedVehicle.stage1Power / selectedVehicle.stockPower - 1) * 100)}% POWER`;\n    document.querySelector('[data-gain=\"stage2\"]').textContent = `+${Math.round((selectedVehicle.stage2Power / selectedVehicle.stockPower - 1) * 100)}% POWER`;\n    const subject = encodeURIComponent(`Tune enquiry: ${selectedVehicle.make} ${selectedVehicle.model} ${selectedVehicle.submodel} ${selectedVehicle.years} ${selectedVehicle.engine}`);\n    document.querySelector(\"#enquiry-link\").href = `mailto:info@psiperformance.com.au?subject=${subject}`;\n    renderMetrics();\n    emptyState.hidden = true;\n    results.hidden = false;\n    results.scrollIntoView({ behavior: window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches ? \"auto\" : \"smooth\", block: \"nearest\" });\n  }\n\n  unitButtons.forEach(button => button.addEventListener(\"click\", () => {\n    currentUnits = button.dataset.units;\n    unitButtons.forEach(item => {\n      const active = item === button;\n      item.classList.toggle(\"active\", active);\n      item.setAttribute(\"aria-pressed\", String(active));\n    });\n    if (selectedVehicle) renderMetrics();\n  }));\n\n  document.querySelector(\"#reset-button\").addEventListener(\"click\", () => {\n    form.reset();\n    resetAfter(\"make\");\n    setEmptyState(\"YOUR RESULTS WILL APPEAR HERE\", \"Complete the vehicle selections above to see estimated power and torque gains.\");\n    fields.make.focus();\n  });\n\n  document.querySelector(\"#copyright-year\").textContent = new Date().getFullYear();\n})();\n</script>\n{% endif %}\n{% if request.page_type == 'index' %}\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  var media = document.querySelector('deferred-media[data-media-id=\"23956419870849\"]');\n  var template = media && media.querySelector('template');\n  var source = template && template.content.querySelector('video source');\n  if (source) {\n    source.setAttribute('src', 'https://cdn.shopify.com/videos/c/o/v/96965f9fa07147758cbbd4eb304d5ffe.mp4');\n  }\n});\n</script>\n{% endif %}",
