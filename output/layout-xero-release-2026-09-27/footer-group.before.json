    "custom_liquid_XthbUy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% if page.handle == 'power-estimator' %}\n<div id=\"psi-estimator\">\n    <section class=\"hero\" aria-labelledby=\"page-title\">\n      <div class=\"hero-grid\" aria-hidden=\"true\"></div>\n      <div class=\"hero-glow\" aria-hidden=\"true\"></div>\n      <div class=\"hero-content\">\n        <p class=\"eyebrow\"><span></span> PSI power estimator</p>\n        <h1 id=\"page-title\">UNLOCK YOUR<br><em>CAR'S<br><span class=\"potential-word\">POTENTIAL.</span></em></h1>\n        <p class=\"hero-lead\">Explore your vehicle's factory output and estimated performance potential through PSI Stage 1, Stage 2 and custom build packages.</p>\n        <div class=\"hero-stats\" aria-label=\"Service highlights\">\n          <div><strong>DYNO DEVELOPED</strong><span>Vehicle-specific calibration</span></div>\n          <div><strong>46 MARQUES</strong><span>Cars and vans rollout</span></div>\n          <div><strong>PSI BUILT</strong><span>From street to full build</span></div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"estimator-section\" id=\"estimator\" aria-labelledby=\"estimator-title\">\n      <div class=\"section-intro\">\n        <p class=\"eyebrow dark\"><span></span> Find your vehicle</p>\n        <h2 id=\"estimator-title\">WHAT COULD YOUR CAR MAKE?</h2>\n        <p>Select each option in order to reveal estimated factory, Stage 1 and Stage 2 output, plus the right pathway for more serious combinations.</p>\n      </div>\n\n      <div class=\"catalogue-strip\" aria-label=\"Estimator catalogue scope\">\n        <div><span>Catalogue</span><strong>46 manufacturers</strong></div>\n        <div><span>Vehicle scope</span><strong>Cars &amp; vans only</strong></div>\n        <div><span>Market focus</span><strong>Australian delivered</strong></div>\n        <p><span class=\"status-dot\" aria-hidden=\"true\"></span> Verified records are being released progressively</p>\n      </div>\n\n      <form class=\"vehicle-form\" id=\"vehicle-form\">\n        <div class=\"select-field vehicle-type-field\">\n          <label for=\"vehicle-type\"><span>01</span> Vehicle type</label>\n          <select id=\"vehicle-type\" name=\"vehicle-type\">\n            <option selected>Cars / Vans</option>\n          </select>\n        </div>\n        <div class=\"select-field\">\n          <label for=\"manufacturer\"><span>02</span> Manufacturer</label>\n          <select id=\"manufacturer\" name=\"manufacturer\" required>\n            <option value=\"\">Select manufacturer</option>\n          </select>\n        </div>\n        <div class=\"select-field\">\n          <label for=\"model\"><span>03</span> Model</label>\n          <select id=\"model\" name=\"model\" disabled required>\n            <option value=\"\">Select model</option>\n          </select>\n        </div>\n        <div class=\"select-field\">\n          <label for=\"submodel\"><span>04</span> Sub-model</label>\n          <select id=\"submodel\" name=\"submodel\" disabled required>\n            <option value=\"\">Select sub-model</option>\n          </select>\n        </div>\n        <div class=\"select-field\">\n          <label for=\"year\"><span>05</span> Year / series</label>\n          <select id=\"year\" name=\"year\" disabled required>\n            <option value=\"\">Select year</option>\n          </select>\n        </div>\n        <div class=\"select-field\">\n          <label for=\"engine\"><span>06</span> Engine</label>\n          <select id=\"engine\" name=\"engine\" disabled required>\n            <option value=\"\">Select engine</option>\n          </select>\n        </div>\n      </form>\n\n      <div class=\"empty-state\" id=\"empty-state\" aria-live=\"polite\">\n        <div class=\"gauge-icon\" aria-hidden=\"true\"><span></span></div>\n        <h3 id=\"empty-title\">YOUR RESULTS WILL APPEAR HERE</h3>\n        <p id=\"empty-copy\">Complete the vehicle selections above to see estimated power and torque gains.</p>\n      </div>\n\n      <article class=\"results\" id=\"results\" hidden aria-live=\"polite\" aria-labelledby=\"result-vehicle\">\n        <header class=\"results-header\">\n          <div>\n            <p class=\"result-kicker\">Selected vehicle</p>\n            <h3 id=\"result-vehicle\"></h3>\n            <p id=\"result-engine\"></p>\n            <p class=\"result-status\" id=\"result-status\"></p>\n            <p class=\"psi-evidence\" id=\"psi-evidence\" hidden></p>\n          </div>\n          <button class=\"reset-button\" id=\"reset-button\" type=\"button\">Change vehicle</button>\n        </header>\n\n        <div class=\"unit-switch\" role=\"group\" aria-label=\"Power units\">\n          <button type=\"button\" class=\"active\" data-units=\"metric\" aria-pressed=\"true\">kW / Nm</button>\n          <button type=\"button\" data-units=\"imperial\" aria-pressed=\"false\">hp / lb-ft</button>\n        </div>\n\n        <div class=\"stage-grid\">\n          <section class=\"stage-card factory\">\n            <div class=\"stage-name\"><span>Original</span><strong>FACTORY</strong></div>\n            <div class=\"metric\"><span>Power</span><strong data-value=\"stockPower\">—</strong><small data-power-unit>kW</small></div>\n            <div class=\"metric\"><span>Torque</span><strong data-value=\"stockTorque\">—</strong><small data-torque-unit>Nm</small></div>\n            <p>Manufacturer-rated baseline</p>\n          </section>\n          <section class=\"stage-card stage-one\">\n            <div class=\"stage-name\"><span>OTR + calibration</span><strong>STAGE 1</strong></div>\n            <div class=\"gain\" data-gain=\"stage1\">+0%</div>\n            <div class=\"metric\"><span>Power</span><strong data-value=\"stage1Power\">—</strong><small data-power-unit>kW</small></div>\n            <div class=\"metric\"><span>Torque</span><strong data-value=\"stage1Torque\">—</strong><small data-torque-unit>Nm</small></div>\n            <p>Over-the-radiator intake and custom dyno calibration. Vehicle suitability applies.</p>\n          </section>\n          <section class=\"stage-card stage-two\">\n            <div class=\"stage-name\"><span>Breathing upgrades</span><strong>STAGE 2</strong></div>\n            <div class=\"gain\" data-gain=\"stage2\">+0%</div>\n            <div class=\"metric\"><span>Power</span><strong data-value=\"stage2Power\">—</strong><small data-power-unit>kW</small></div>\n            <div class=\"metric\"><span>Torque</span><strong data-value=\"stage2Torque\">—</strong><small data-torque-unit>Nm</small></div>\n            <p>OTR/intake, exhaust or downpipes and custom dyno calibration.</p>\n          </section>\n          <section class=\"stage-card stage-three\">\n            <div class=\"stage-name\"><span>Cam or turbo package</span><strong>STAGE 3</strong></div>\n            <div class=\"custom-output\">\n              <span>Output</span>\n              <strong>BUILT TO SUIT</strong>\n              <small>Camshaft or turbo upgrades vary by combination</small>\n            </div>\n            <p>OTR/intake, exhaust/downpipes, camshaft or turbo upgrade and custom dyno calibration.</p>\n          </section>\n          <section class=\"stage-card stage-four\">\n            <div class=\"stage-name\"><span>Bespoke build</span><strong>STAGE 4</strong></div>\n            <div class=\"custom-output\">\n              <span>Pricing & output</span>\n              <strong>WRITE IN<br>FOR A QUOTE</strong>\n              <small>Engine, fuel, drivetrain and intended use assessed individually</small>\n            </div>\n            <p>For stroker engines, built motors, major forced induction and complete vehicle packages.</p>\n          </section>\n        </div>\n\n        <div class=\"result-footer\">\n          <p><strong>Ready to transform your car?</strong> Tell us your current modifications and intended use for a vehicle-specific recommendation.</p>\n          <a href=\"mailto:info@psiperformance.com.au?subject=Power%20estimator%20enquiry\" id=\"enquiry-link\">Enquire about this tune <span aria-hidden=\"true\">→</span></a>\n        </div>\n      </article>\n\n      <aside class=\"disclaimer\">\n        <strong>Estimator notice:</strong> This is a development preview. Published figures require final PSI approval and must not be used for customer quotations yet. Results are indicative engine-output estimates, not guaranteed wheel figures. Actual output varies with fuel, vehicle condition, transmission, supporting modifications, dyno type and environmental conditions.\n      </aside>\n    </section>\n  </div><style>@font-face {\n  font-family: \"Ethnocentric\";\n  src: url(\"https://cdn.shopify.com/s/files/1/0587/8851/1873/files/Ethnocentric_Rg.woff2?v=1747744155\") format(\"woff2\");\n  font-style: normal;\n  font-display: swap;\n}\n\n#psi-estimator {\n  --ink: #090a0c;\n  --panel: #101216;\n  --muted: #666b73;\n  --line: #d9dce0;\n  --paper: #f2f2f0;\n  --white: #fff;\n  --accent: #ffffff;\n  --blue: #8f969f;\n  --shadow: 0 24px 70px rgba(9,10,12,.12);\n}\n\n#psi-estimator, #psi-estimator * { box-sizing:border-box; }\n#psi-estimator { margin:0; color:var(--ink); background:var(--paper); font-family:Inter,Arial,sans-serif; }\n#psi-estimator button, #psi-estimator select { font: inherit; }\n#psi-estimator a { color: inherit; }\n.skip-link { position: fixed; z-index: 100; top: 12px; left: 12px; transform: translateY(-160%); color: #121212; background: var(--accent); padding: 12px 18px; font-weight: 700; }\n.skip-link:focus { transform: none; }\n\n.topbar { min-height: 32px; display: flex; justify-content: space-between; align-items: center; padding: 0 clamp(22px, 5vw, 80px); color: #858991; background: #050608; border-bottom: 1px solid #1e2024; font-size: 9px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }\n.site-header { position: relative; z-index: 10; height: 82px; display: flex; justify-content: space-between; align-items: center; padding: 0 clamp(22px, 5vw, 80px); color: white; background: rgba(8,9,11,.98); border-bottom: 1px solid #282b2f; }\n.brand { display: flex; align-items: center; gap: 13px; text-decoration: none; }\n.brand img { display: block; width: auto; height: 46px; object-fit: contain; }\n.header-cta { padding: 14px 20px; border: 1px solid #44484f; text-decoration: none; text-transform: uppercase; font-size: 11px; font-weight: 700; letter-spacing: .11em; transition: .2s ease; }\n.header-cta:hover, .header-cta:focus-visible { color: #121212; background: white; border-color: white; }\n\n.hero { position: relative; min-height: 610px; overflow: hidden; display: grid; align-items: center; color: white; background: radial-gradient(circle at 82% 48%, #272a2e 0, #111317 29%, #07080a 67%); }\n.hero::before { content: \"\"; position: absolute; top: 0; right: 7%; width: 13%; height: 100%; background: rgba(255,255,255,.42); transform: skewX(-18deg) translateX(90%); opacity: .13; }\n.hero::after { content: \"\"; position: absolute; right: -4%; bottom: -36%; width: 63%; aspect-ratio: 2.1; border-radius: 50%; border: 46px solid rgba(255,255,255,.055); transform: rotate(-8deg); }\n.hero-grid { position: absolute; inset: 0; opacity: .11; background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 70px 70px; mask-image: linear-gradient(90deg, #000, transparent 80%); }\n.hero-glow { position: absolute; width: 350px; height: 350px; right: 10%; background: white; filter: blur(160px); opacity: .08; }\n.hero-content { position: relative; z-index: 1; width: min(1220px, calc(100% - 44px)); margin: auto; padding: 90px 0; }\n.eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 17px; color: #b3b7bc; font-size: 11px; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }\n.eyebrow span { width: 28px; height: 3px; background: var(--accent); }\n.eyebrow.dark { color: #656a72; }\n.eyebrow.dark span { background: #121212; }\n#psi-estimator h1, #psi-estimator h2