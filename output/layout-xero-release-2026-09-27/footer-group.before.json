ta-variant=\"ready\"] { border-style: solid; }\n.empty-state h3 { margin: 22px 0 7px; font-size: 25px; letter-spacing: .04em; }\n.empty-state p { margin: 0; color: var(--muted); }\n.gauge-icon { position: relative; width: 76px; height: 40px; overflow: hidden; border: 7px solid #cfd2d5; border-bottom: 0; border-radius: 76px 76px 0 0; }\n.gauge-icon span { position: absolute; left: 30px; bottom: -2px; width: 30px; height: 3px; background: #121212; transform-origin: left; transform: rotate(-40deg); }\n\n.results { margin-top: 28px; color: white; background: var(--panel); box-shadow: 0 28px 70px rgba(8,9,11,.2); }\n.results-header { display: flex; justify-content: space-between; align-items: center; padding: 30px 34px; border-bottom: 1px solid #2b2e33; }\n.result-kicker { margin: 0 0 5px; color: var(--accent); font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }\n.results-header h3 { margin: 0; font-size: 34px; line-height: 1; }\n.results-header p:last-child { margin: 7px 0 0; color: #8d9299; font-size: 13px; }\n.results-header .result-status { margin: 13px 0 0; max-width: 760px; color: #b9bcc1; font-size: 10px; font-weight: 700; line-height: 1.55; letter-spacing: .075em; text-transform: uppercase; }\n.result-status::before { content: \"\"; display: inline-block; width: 7px; height: 7px; margin: 0 8px 1px 0; background: var(--accent); border-radius: 50%; }\n.results-header .psi-evidence { display: inline-block; margin-top: 12px; padding: 7px 9px; color: #fff; background: rgba(255,255,255,.08); border-left: 2px solid var(--accent); font-size: 11px; }\n.results-header .psi-evidence[hidden] { display: none; }\n.reset-button { padding: 11px 14px; color: white; background: transparent; border: 1px solid #41454c; cursor: pointer; }\n.reset-button:hover, .reset-button:focus-visible { color: var(--ink); background: white; }\n.unit-switch { display: flex; justify-content: flex-end; padding: 18px 30px 0; }\n.unit-switch button { padding: 8px 12px