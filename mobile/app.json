{
  "expo": {
    "name": "PSI Performance",
    "slug": "matt-psi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/psi-app-icon-1024.png",
    "scheme": "psiperformance",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.psiperformance.booking",
      "buildNumber": "1",
      "icon": "./assets/images/psi-app-icon-1024.png"
    },
    "android": {
      "package": "com.psiperformance.booking",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/psi-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/psi-app-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/psi-splash-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e62e9cdf-867c-4eb7-b8c5-a2610f969286"
      }
    },
    "owner": "psi-performance"
  }
}
